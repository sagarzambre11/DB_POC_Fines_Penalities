# Azure OpenAI Configuration
# Copy this file to .env and fill in your actual values

AZURE_OPENAI_ENDPOINT=https://<your-resource-name>.openai.azure.com/
AZURE_OPENAI_API_KEY=<your-api-key-here>
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-02-01

# Embedding Provider (optional — default: azure)
# Set to "google" to use Google text-embedding-004 instead of Azure
# EMBEDDING_PROVIDER=azure
# AZURE_EMBEDDING_DEPLOYMENT=text-embedding-3-small
# AZURE_EMBEDDING_API_VERSION=2024-02-01
# GOOGLE_API_KEY=<your-google-api-key>
# GOOGLE_EMBEDDING_MODEL=models/text-embedding-004

# Embedding timeout / retry tuning (optional — safe to leave commented out)
# Increase EMBED_TIMEOUT_READ if you get "Request timed out" on slow networks.
# EMBED_TIMEOUT_CONNECT=15   # seconds to establish connection (default: 15)
# EMBED_TIMEOUT_READ=120     # seconds to wait for embedding response (default: 120)
# EMBED_TIMEOUT_WRITE=30     # seconds to send request body (default: 30)
# EMBED_CHUNK_SIZE=50        # controls embedded per API call (default: 50)
# EMBED_MAX_RETRIES=3        # retry attempts per chunk on failure (default: 3)

# RAG / Vector Store (optional — defaults shown)
# VECTOR_DB_PATH=.chromadb
# RETRIEVAL_TOP_K=8
# MAX_RETRIEVED_CONTROLS=15

# GRC Inventory (optional — defaults shown)
# GRC_INVENTORY_PATH=docs/grc_inventory.xlsx
# GRC_SHEET_NAME=grc_control_inv1
